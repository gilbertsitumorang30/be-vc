{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "preserve",
    "target": "es2022",
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "coverage", "drizzle"]
}

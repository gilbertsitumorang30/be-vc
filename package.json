{
  "name": "resto-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch src/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "cross-env NODE_ENV=development drizzle-kit migrate",
    "db:migrate:test": "cross-env NODE_ENV=test drizzle-kit migrate",
    "db:seed:dev": "cross-env NODE_ENV=development tsx src/db/seeders/index.ts",
    "db:seed:test": "cross-env NODE_ENV=test tsx src/db/seeders/index.ts",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "docker:dev:up": "docker compose --env-file .env.development -f docker/compose.dev.yml up -d",
    "docker:dev:down": "docker compose --env-file .env.development -f docker/compose.dev.yml down"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  }
}
